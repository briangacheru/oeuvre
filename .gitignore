# Secrets / environment — never commit; use .env.example as the template
.env

# OS cruft
.DS_Store

# Logs
*.log

# Composer dependencies — single shared vendor/ for both interfaces, regenerate with `composer install`
# composer.lock IS tracked (pins exact versions) — do not ignore it
/vendor/

# User-uploaded runtime content (keep folder structure + hardening, not the data)
/profileimages/*
!/profileimages/1.jpg
!/profileimages/default.jpg
!/profileimages/.gitkeep
!/profileimages/.htaccess
/taskfiles/*
!/taskfiles/.gitkeep
!/taskfiles/.htaccess
/uploads/*
!/uploads/.htaccess
!/uploads/tasks/
/uploads/tasks/*
!/uploads/tasks/.gitkeep
!/uploads/project_attachments/
/uploads/project_attachments/*
!/uploads/project_attachments/.gitkeep

# Database backups — full DB dumps (PII + financial data), never commit
/backups/*
!/backups/.gitkeep
!/backups/.htaccess

# Sample bank/Mpesa statement PDFs used to build the transactions PDF-import
# feature — real financial data, never commit
/statement-samples/*
!/statement-samples/.gitkeep
